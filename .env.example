# --- AI Gateway -------------------------------------------------------------
# Local gateway: https://localhost:8081 (self-signed, set INSECURE_TLS=true)
GATEWAY_URL=https://localhost:8081
GATEWAY_API_KEY=
INSECURE_TLS=true

# Model ids as configured in the gateway (bedrock.local.config.json defaults).
# The chat model must have semanticCache.isEnabled=true in its cacheConfig.
CHAT_MODEL=bedrock-global-anthropic-claude-haiku-4-5-20251001-v1-0
EMBED_MODEL=bedrock-amazon-titan-embed-text-v2-0
EXPECTED_EMBED_DIMS=1024

# Prometheus endpoint of the gateway (blank to skip the metrics claim)
METRICS_URL=http://localhost:9090/metrics
# serviceName lower-cased, spaces -> "_" ("AI Model Service Gateway" by default)
METRICS_PREFIX=ai_model_service_gateway_

# Time to let the vector index pick up a freshly stored cache entry
SETTLE_MS=2500

# --- Optional ---------------------------------------------------------------
# A second API key, to show whether the cache is shared across keys
GATEWAY_API_KEY_2=

# Couchbase access to the gateway's cache keyspace (cacheStore in the model
# config), to inspect what a cache document actually contains.
# Needs `npm install couchbase` (optional dependency) and a primary index or
# any index on that collection.
CB_CONNECTION_STRING=
CB_USERNAME=
CB_PASSWORD=
CB_CACHE_KEYSPACE=aigw.va.caching-bedrock

# --- Demo questions -------------------------------------------------------
Q1="quiet headphones for flying"
Q2="noise cancelling headphones for a long flight"
Q3="headphones that block out airplane engine noise"
Q_ADJACENT="waterproof earbuds for swimming laps"
Q_UNRELATED="best mechanical keyboard for programming"

# The app accepts API keys and URLs from its Preferences page: keep it local.
HOST=127.0.0.1
PORT=4000
