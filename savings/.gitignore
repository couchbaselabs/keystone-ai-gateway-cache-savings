.venv/
__pycache__/
.pytest_cache/

# Datasets: the request streams and the inputs they are built from are kept, so
# every run can be reloaded and the streams rebuilt identically without model
# calls. Not kept: the Bitext download (re-fetched by the build) and the 104 MB
# RAG messages file, which `python -m savings datasets --workload rag` rebuilds
# byte-for-byte from capella-docs.jsonl + rag-questions.jsonl.
data/bitext.csv
data/rag-variants.jsonl
data/*.log

# Runs: results stay on the machine that ran them and are shared privately
# (report HTML / CSV from the page), never committed. They are inputs to
# pricing decisions and record gateway settings.
runs/
